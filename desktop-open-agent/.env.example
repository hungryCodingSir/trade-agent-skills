# ── LLM 配置（阿里百炼 / 千问） ──
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 模型选择 ──
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ── 应用配置 ──
APP_NAME=Desktop Open Agent
APP_VERSION=1.0.0
DEBUG=true
HOST=127.0.0.1
PORT=8000
